ORIGIN=http://localhost:5183

# Session secret (required — the server will not start without it)
SESSION_SECRET="your-session-secret-here"

# OBP API
PUBLIC_OBP_BASE_URL="http://localhost:8080"

# Largest request body, for applicants' document uploads (up to 5 MB). Read by `node build`, not by the dev server.
BODY_SIZE_LIMIT=6M

# Bank id of the space that holds OBP-Cohort's dynamic entities (one space per installation)
OBP_ENTITY_SPACE_ID=cohort

# OIDC client "obp-cohort" (redirect http://localhost:5183/login/obp/callback). In the TESOBE dev setup
# commands/_helpers/sync_obp_consumers.sh creates it and writes these two values.
# The providers themselves are discovered from OBP-API's well-known endpoint.
OBP_OAUTH_CLIENT_ID=
OBP_OAUTH_CLIENT_SECRET=
APP_CALLBACK_URL=http://localhost:5183/login/obp/callback

# Optional further providers (only used if OBP-API lists them at its well-known endpoint)
# KEYCLOAK_OAUTH_CLIENT_ID=
# KEYCLOAK_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Redis (sessions); defaults to localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
