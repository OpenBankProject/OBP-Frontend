ORIGIN=http://localhost:3003

# Session secret (required — server will not start without it)
SESSION_SECRET="your-session-secret-here"

# OBP API Configuration
PUBLIC_OBP_BASE_URL="http://localhost:8080"

# OIDC Configuration
OBP_OAUTH_CLIENT_ID=2a47cc56-0db1-409d-8f0b-131e4f94a212
OBP_OAUTH_CLIENT_SECRET=OR04Ga8uQjdzFmNXDI5QrEXHN30Fk4u6lbtbrrMsj8g
OBP_OAUTH_WELL_KNOWN_URL=http://127.0.0.1:9000/obp-oidc/.well-known/openid-configuration
VITE_OIDC_ISSUER=http://127.0.0.1:9000
VITE_CLIENT_ID=2a47cc56-0db1-409d-8f0b-131e4f94a212
APP_CALLBACK_URL=http://localhost:3003/login/obp/callback

# /status page: the OIDC health check attempts a client_credentials token
# exchange against each provider's token_endpoint using the OBP_OAUTH_* /
# KEYCLOAK_OAUTH_* credentials, throttled to once per hour. The outcome is
# surfaced in the service's details. Set to "false" to disable the probe
# (e.g. if the client isn't registered for the client_credentials grant and
# you don't want noise in the provider's audit log).
# OIDC_HEALTHCHECK_TEST_TOKEN=true
# When "true", a failed token test flips the service unhealthy. Only enable
# if you're certain the client is registered for the client_credentials grant.
# OIDC_HEALTHCHECK_TEST_TOKEN_STRICT=false

# Opey Configuration
OPEY_BASE_URL="http://localhost:5000"
PUBLIC_OPEY_BASE_URL=http://localhost:5000


# Show or hide the Opey Notebook bar and read / write / think about Opey Notebook data.
PUBLIC_OPEY_NOTEBOOK_ENABLED=false

##################################################################
# We need *Opey's* consumer_id (ID NOT KEY!) so the Portal can generate a consent for Opey to use.
# This the ID of the consumer that matches a consumer in the OBP database
# Opey sends its CONSUMER_KEY in the header or sends a certificate
OPEY_CONSUMER_ID="74545fb7-9a1f-4ee0-beb4-6e5b7ee50076"

############################################################

# External URLs
API_EXPLORER_URL="https://test-explorer-ii.openbankproject.com/?tags=&locale=en_GB"
API_MANAGER_URL="https://test-manager.openbankproject.com/"
SUBSCRIPTIONS_URL="https://test-subscriptions.openbankproject.com"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# UI Configuration
PUBLIC_LOGO_URL="/logo2x-1.png"
PUBLIC_DARK_LOGO_URL="/obp_logo.svg"
PUBLIC_LOGO_WIDTH="100%"

# Links for documentation and for other reasons. No default
API_EXPLORER_URL=http://localhost:5173

# OBP gRPC endpoint (used for live log-cache streaming). Server-only — the browser talks to SvelteKit's /backend/log-cache/stream SSE proxy, never directly to gRPC.
# Defaults to grpc.<PUBLIC_OBP_BASE_URL hostname>:50051 if not set (no grpc. prefix for localhost/IPs).
OBP_GRPC_HOST=localhost:50051
OBP_GRPC_AUTH_METADATA_KEY=authorization
OBP_GRPC_AUTH_METADATA_VALUE_TEMPLATE=Bearer {token}

# Shared-secret that lets automated tests bypass rate limiting by sending a
# `Rate-Limit-Bypass-Token: <token>` header. Leave unset in production.
# RATE_LIMIT_BYPASS_TOKEN=

# Google OIDC Configuration (used when the OBP API advertises a "google" provider in /well-known)
# The Google OAuth client must list APP_CALLBACK_URL as an authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
