# OBP-API, and the OIDC issuer whose token endpoint gives the runner its token (client credentials)
OBP_BASE_URL=http://localhost:8080
OIDC_ISSUER=http://localhost:9000/obp-oidc

# OIDC client "obp-conformator-runner" (client credentials, no redirect). In the TESOBE dev setup
# commands/_helpers/sync_obp_consumers.sh creates it and writes these two values.
OBP_OAUTH_CLIENT_ID=
OBP_OAUTH_CLIENT_SECRET=

# Bank id of Conformator's central space (the same value as the web app's OBP_ENTITY_SPACE_ID)
OBP_ENTITY_SPACE_ID=conformator

# How often to look for queued runs, in seconds, and how many runs to run at once
RUNNER_POLL_SECONDS=15
RUNNER_CONCURRENCY=2

# The folder holding the secrets participants give the runner, one sub-folder per system id. See README.md.
RUNNER_CREDENTIALS_DIR=./credentials

# The longest the runner waits for a participant's system to answer one request, in seconds
RUNNER_REQUEST_TIMEOUT_SECONDS=30

# The OpenID Foundation's conformance suite, for openid:plan checks (FAPI and OpenID Connect). Leave unset to run
# without it; tests that need it are then blocked, saying why. See dev/openid-suite/README.md to run one locally.
# OPENID_SUITE_URL=https://localhost.emobix.co.uk:8443
# An API token, when the suite is not in its development mode
# OPENID_SUITE_TOKEN=
# The CA of the suite's TLS certificate, when it is not a public one
# OPENID_SUITE_CA_FILE=
# The longest one module of a plan may take, in seconds
# OPENID_SUITE_MODULE_TIMEOUT_SECONDS=600
