ORIGIN=http://localhost:5185

# Session secret (required: the server will not start without it)
SESSION_SECRET="your-session-secret-here"

# OBP API
PUBLIC_OBP_BASE_URL="http://localhost:8080"

# Largest request body, for a suite's OpenAPI file (up to 5 MB). Read by `node build`, not by the dev server.
BODY_SIZE_LIMIT=6M

# Bank id of the central space: the test catalogue, the participant register and the reports.
# Each participant gets a space of their own, named <this>-<participant>, set up from the participant's page.
OBP_ENTITY_SPACE_ID=conformator

# OIDC client "obp-conformator" (redirect http://localhost:5185/login/obp/callback).
# The providers themselves are discovered from OBP-API's well-known endpoint.
OBP_OAUTH_CLIENT_ID=
OBP_OAUTH_CLIENT_SECRET=
APP_CALLBACK_URL=http://localhost:5185/login/obp/callback

# Optional further providers (only used if OBP-API lists them at its well-known endpoint)
# KEYCLOAK_OAUTH_CLIENT_ID=
# KEYCLOAK_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Redis (sessions); defaults to localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# The runner's Consumer at OBP-API, by consumer_id (shown on the runner's log and in the API Manager). Setting up a
# participant's space grants it the Scopes it needs there. Without it, spaces are set up but the runner cannot use them.
# CONFORMATOR_RUNNER_CONSUMER_ID=

# The Ed25519 private key (PEM, PKCS#8) that signs conformance reports. Without it no report can be issued.
# Make one with: openssl genpkey -algorithm ed25519 -out report-signing.pem
# The public key is published at /reports/signing-key. Keep the private key out of the repository.
# REPORT_SIGNING_KEY_FILE=/path/to/report-signing.pem
# How long a report is valid, in months (default 12)
# REPORT_VALID_MONTHS=12

# Opey, beside the suite page, where it helps write tests (shown only when OPEY_BASE_URL is set).
# OPEY_CONSUMER_ID is Opey's Consumer at OBP-API, the same as in the Portal's .env. OBP-API must let this app give
# Opey a consent without a challenge (skip_consent_sca_for_consumer_id_pairs); in the TESOBE dev setup
# commands/_helpers/sync_obp_consumers.sh sets both.
# OPEY_BASE_URL=http://localhost:5000
# PUBLIC_OPEY_BASE_URL=http://localhost:5000
# OPEY_CONSUMER_ID=
# The tool's own focus for Opey, sent by the server with every message and appended after Opey's
# OPEY_SUPPLEMENTARY_PROMPT (per OBP instance, shared by every app). The tool always adds where its catalogue is and
# how a test is written after it. The _FILE form (e.g. a mounted ConfigMap) wins; no restart needed.
# OPEY_APP_SUPPLEMENTARY_PROMPT="Answer as the regulator's conformance team."
# OPEY_APP_SUPPLEMENTARY_PROMPT_FILE=/config/conformator-opey-prompt.md

# Which digits Arabic pages show numbers and dates in: western (123, the default) or arabic-indic (١٢٣). Codes such as account numbers, versions and IDs always stay as they are.
# ARABIC_DIGITS=western
