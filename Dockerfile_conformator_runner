FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
COPY apps/portal/package*.json ./apps/portal/
COPY apps/api-manager/package*.json ./apps/api-manager/
COPY apps/cohort/package*.json ./apps/cohort/
COPY apps/conformator/package*.json ./apps/conformator/
COPY apps/conformator-runner/package*.json ./apps/conformator-runner/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci

COPY packages/shared/ ./packages/shared/
COPY apps/conformator-runner/ ./apps/conformator-runner/

# esbuild bundles the runner and the shared code it uses into one file with no runtime dependencies.
RUN npm run build --workspace=apps/conformator-runner

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/apps/conformator-runner/dist/main.js ./main.js
ENV NODE_ENV=production
# Secrets participants give the runner: mount them here (for example a Kubernetes Secret).
ENV RUNNER_CREDENTIALS_DIR=/credentials
USER node
CMD [ "node", "main.js" ]
